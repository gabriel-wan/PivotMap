# Database
DATABASE_URL=postgresql+psycopg://pivotmap:pivotmap@localhost:5432/pivotmap

# pgvector
PGVECTOR_ENABLED=true

# MiroMind
MIROMIND_API_KEY=your_key_here

# MiroFlow agent framework (used by `uv run main.py trace` when the
# miroflow extra is installed; OpenRouter is MiroFlow's default LLM gateway)
OPENROUTER_API_KEY=your_key_here

# Institution adapter
DEFAULT_INSTITUTION=NUS

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
